# Copia este archivo como ".env" y completa tus datos reales.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cnsb_lab
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# URL pública del sistema. Se usa para armar el enlace de la factura digital que se
# envía por WhatsApp. Si pruebas en tu PC usa http://localhost (el cliente no podrá abrirlo
# desde su teléfono); cuando lo subas a un servidor pon el dominio real, ej: https://lab.tudominio.com
APP_URL=http://localhost

# Zona horaria del negocio
APP_TIMEZONE=America/Caracas

# true = muestra errores técnicos en pantalla (solo para desarrollo). En producción: false
APP_DEBUG=false
